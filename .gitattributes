# Normalizar finales de línea automáticamente
* text=auto eol=lf

# Binarios — sin conversión
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf

# Scripts y config de despliegue: siempre LF (si no, fallan en Linux)
*.sh text eol=lf
deploy/Caddyfile.* text eol=lf
